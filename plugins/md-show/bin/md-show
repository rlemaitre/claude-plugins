#!/usr/bin/env bash
# Show a Markdown file as a readable HTML page in a terminal-browser split, next to the terminal.
# Usage: md-show <file.md>
set -euo pipefail

if [[ $# -ne 1 || ! -f "$1" ]]; then
  echo "usage: md-show <existing file.md>" >&2
  exit 2
fi

assets="$(cd "$(dirname "${BASH_SOURCE[0]}")/../assets" && pwd)"
src="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
out_dir="${XDG_CACHE_HOME:-$HOME/.cache}/md-show"
mkdir -p "$out_dir"
# One page per source path, so showing the same file again overwrites it.
out="$out_dir/$(basename "${src%.*}")-$(printf '%s' "$src" | shasum | cut -c1-8).html"

# base keeps relative links and images pointing next to the source file.
pandoc "$src" --from gfm --to html5 --standalone \
  --template "$assets/template.html" \
  --lua-filter "$assets/mermaid.lua" \
  --metadata pagetitle="$(basename "$src")" \
  --variable base="file://$(dirname "$src" | sed 's/%/%25/g; s/"/%22/g; s/</%3C/g; s/>/%3E/g')/" \
  --output "$out"

# Without XDG_RUNTIME_DIR: ours makes terminal-browser's agent socket paths too long (dotfiles docs/upstream-watch.md).
tb() { env -u XDG_RUNTIME_DIR terminal-browser "$@"; }

if tb ls 2>/dev/null | grep -q '(this tab)'; then
  tb new-tab "$out" >/dev/null 2>&1 && { echo "md-show: opened in a new terminal-browser tab"; exit 0; }
elif tb open "$out" --split right >/dev/null 2>&1; then
  echo "md-show: opened in a terminal-browser split"
  exit 0
fi

# terminal-browser needs a terminal with the kitty graphics protocol. Elsewhere (Claude's desktop app, an IDE
# terminal), show the page in the default browser.
opener="$(command -v open || command -v xdg-open || true)"
if [[ -n "$opener" ]] && "$opener" "$out"; then
  echo "md-show: terminal-browser cannot display here, opened in the default browser: $out"
else
  echo "md-show: no way to display the page here; open it by hand: $out" >&2
  exit 1
fi
